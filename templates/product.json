                        "custom_liquid": "{% style %}\n.supplement-facts {\n    --color-neutral-900: #273a2d;\n    --color-neutral-800: #3e5044;\n    --color-neutral-300: #b6bdb8;\n\n    font-size: 14px;\n    color: var(--color-neutral-800);\n    width: 100%;\n    max-width: 720px;\n    padding-top: 8px;\n  }\n\n  .supplement-facts p {\n    margin: 0 0 4px 0;\n    line-height: 1.5;\n    letter-spacing: -0.5px;\n    text-wrap: pretty;\n  }\n\n  .supplement-facts table {\n    width: 100%;\n    border-collapse: collapse;\n    table-layout: fixed;\n    margin: 10px 0;\n    color: inherit;\n  }\n\n  /* Column Widths */\n  .supplement-facts th:nth-child(1) {\n    width: 50%;\n  }\n  .supplement-facts th:nth-child(2) {\n    width: 15%;\n  }\n  .supplement-facts th:nth-child(3) {\n    width: 35%;\n  }\n\n  /* Table Headers */\n  .supplement-facts thead tr {\n    border-top: 2px solid var(--color-neutral-600);\n    border-bottom: 2px solid var(--color-neutral-600);\n  }\n\n  .supplement-facts th {\n    padding: 8px 2px;\n    text-align: left;\n    font-weight: 500;\n  }\n\n  /* Table Body Rows */\n  .supplement-facts tbody tr {\n    border-bottom: 1px solid var(--color-neutral-200);\n  }\n\n  .supplement-facts tbody tr:last-child {\n    border-bottom: 2px solid var(--color-neutral-600);\n  }\n\n  /* Table Cells (General) */\n  .supplement-facts td {\n    padding: 8px 4px;\n    vertical-align: top;\n  }\n\n  .supplement-facts tbody tr:first-child > td {\n    padding-top: 14px;\n  }\n\n  .supplement-facts tbody tr:last-child > td {\n    padding-bottom: 12px;\n  }\n\n  /* Shared and Specific Alignment / Wrapping */\n  .supplement-facts th:last-child,\n  .supplement-facts td:last-child {\n    text-align: right;\n  }\n\n  .supplement-facts th:last-child,\n  .supplement-facts td:nth-child(2) {\n    white-space: nowrap;\n  }\n\n  .supplement-facts td:first-child {\n    white-space: normal;\n    text-wrap: balance;\n  }\n\n  .footnotes > p {\n    opacity: 0.8;\n    margin-bottom: 1px;\n    font-size: 12px;\n    line-height: 1.4;\n  }\n{% endstyle %}\n\n{% if product.metafields.custom.supplement_facts != blank %}\n  {{ product.metafields.custom.supplement_facts.value }}\n{% endif %}"
                      },
                      "blocks": {}
                    }
                  },
