                      "name": "Sort Component",
                      "settings": {
                        "custom_liquid": "<sorting-filter-component class=\"sorting-filter sorting-filter__horizontal\" on:change=\"/updateFilterAndSorting\" on:keydown=\"/handleKeyDown\" data-testid=\"sorting-filter-component-desktop\" data-should-use-select-on-mobile=\"false\">\n  \n\n  <div class=\"sorting-filter__container  hidden \">\n    <label for=\"sort-select-template--27609231524152__main\" class=\"facets__label\">Sort</label>\n    <div class=\"sorting-filter__select-wrapper\">\n      <select id=\"sort-select-template--27609231524152__main\" name=\"sort_by\" class=\"sorting-filter__select\" disabled=\"\">\n        \n          <option value=\"manual\">\n            Featured\n          </option>\n        \n          <option value=\"most-relevant\" selected=\"\">\n            Most relevant\n          </option>\n        \n          <option value=\"best-selling\">\n            Best selling\n          </option>\n        \n          <option value=\"title-ascending\">\n            Alphabetically, A-Z\n          </option>\n        \n          <option value=\"title-descending\">\n            Alphabetically, Z-A\n          </option>\n        \n          <option value=\"price-ascending\">\n            Price, low to high\n          </option>\n        \n          <option value=\"price-descending\">\n            Price, high to low\n          </option>\n        \n          <option value=\"created-ascending\">\n            Date, old to new\n          </option>\n        \n          <option value=\"created-descending\">\n            Date, new to old\n          </option>\n        \n      </select>\n      <svg aria-hidden=\"true\" focusable=\"false\" class=\"icon icon-caret\" width=\"8\" height=\"13\" viewBox=\"0 0 8 13\">\n\n\n<g opacity=\"0.6\">\n      <path d=\"M4.93509 1.08583C4.44566 0.596391 3.65213 0.596391 3.16269 1.08583L0.509308 3.73921C0.215647 4.03287 0.215647 4.50899 0.509308 4.80265C0.802969 5.09631 1.27909 5.09631 1.57275 4.80265L4.04889 2.32651L6.52504 4.80265C