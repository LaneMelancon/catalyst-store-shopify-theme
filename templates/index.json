            "custom_liquid": "{% style %}\n.color-custom-template--27584646218040__section_GmHD4h {\n  overflow: hidden;\n}\n\n.color-custom-template--27584646218040__section_GmHD4h .group-block:has(.image-block) {\noverflow-x: scroll;\n}\n\n/* Webkit browsers (Chrome, Safari, Edge) */\n.color-custom-template--27584646218040__section_GmHD4h .group-block:has(.image-block)::-webkit-scrollbar {\n  width: 10px;\n  height: 10px;\n}\n\n.color-custom-template--27584646218040__section_GmHD4h .group-block:has(.image-block)::-webkit-scrollbar-track {\n  background: #FFFDF7;\n}\n\n.color-custom-template--27584646218040__section_GmHD4h .group-block:has(.image-block)::-webkit-scrollbar-thumb {\n  background: rgba(130, 87, 13, 0.05);\n  border-radius: 5px;\n}\n\n.color-custom-template--27584646218040__section_GmHD4h .group-block:has(.image-block)::-webkit-scrollbar-thumb:hover {\n  background: rgba(130, 87, 13, 0.05);\n}\n\n/* Firefox */\n.color-custom-template--27584646218040__section_GmHD4h .group-block:has(.image-block) {\n  scrollbar-color: rgba(130, 87, 13, 0.05) #FFFDF7;\n  scrollbar-width: thin;\n}\n\n.color-custom-template--27584646218040__section_GmHD4h .group-block-content {\n  flex-wrap: nowrap;\ndisplay: flex;\nalign-items: center;\njustify-content: flex-start;\ngap: 1.5rem;\n}\n\n.color-custom-template--27584646218040__section_GmHD4h .image-block {\n  flex: auto;\n  opacity: 0.70;\nmin-width: 8rem;\n}\n\n@media (min-width: 750px) {\n.color-custom-template--27584646218040__section_GmHD4h .image-block {\nmin-width: 10rem;\n}\n.color-custom-template--27584646218040__section_GmHD4h .group-block-content {\ngap: 3.75rem;\n}\n}\n{% endstyle %}"
