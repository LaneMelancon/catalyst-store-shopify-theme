                "custom_liquid": "{% assign prodSelector = \".color-custom-template--27679723422008__carousel_Rx4ta6\" %}\n\n{% style %}\n/* Component Wrapper (div) */\n{{ prodSelector }} :has(> .carousel-content) {\n}\n\n/* Slideshow Container */\n{{ prodSelector }} .carousel-content > [ref=\"slideshowContainer\"] {\n  display: flex;\n  flex-direction: column-reverse;\n  align-items: center;\n  gap: 16px;\n}\n\n/* Slideshow Scroller */\n{{ prodSelector }} [ref=\"scroller\"] {\n\n}\n\n/* Slider Card */\n{{ prodSelector }} [ref=\"scroller\"] > .card {\n  max-width: 750px;\n}\n\n/* Card Image Blocks */\n{{ prodSelector }} [ref=\"scroller\"] .card .card__inner .group-block .group-block-content div:has(img) {\naspect-ratio: 1 / 1;\n}\n\n/* Card Pathway Blocks */\n{{ prodSelector }} [ref=\"scroller\"] .card__content .group-block:last-child .group-block-content {\n}\n\n/* Arrows (wrapper) */\n{{ prodSelector }} :has(> .slideshow-control) {\n  flex-direction: row;\n  position: relative;\n  flex-wrap: wrap;\n  flex-direction: row;\n  gap: 16px;\n}\n\n/* Arrow Buttons */\n{{ prodSelector }} button.slideshow-control {\n  background-color: var(--color-secondary-button-background);\n  border: 1px solid rgba(255, 255, 255, 0.25);\n  transition: background-color 150ms ease-in-out;\nanimation: none !important;\n  opacity: 1 !important;\n}\n\n{{ prodSelector }} button.slideshow-control:hover {\n  background-color: rgba(0, 0, 0, 0.7);\n}\n\n{{ prodSelector }} button.slideshow-control[disabled] {\n  display: flex !important;\n  background-color: rgba(0, 0, 0, 0.2);\n}\n\n/* --- Mobile Styles --- */\n@media (max-width: 749px) {\n/* Slideshow Scroller */\n{{ prodSelector }} [ref=\"scroller\"] {\n  margin: 0px;\n  padding: 0px 14px 12px 14px;\n  gap: 8px;\n}\n\n/* Slider Card */\n{{ prodSelector }} [ref=\"scroller\"] .card {\n  width: 100%;\n  height: auto;\n  align-self: auto;\n}\n\n/* Card Image Blocks */\n{{ prodSelector }} [ref=\"scroller\"] .card .card__inner .group-block .group-block-content div:has(img) {\n  aspect-ratio: 1;\n  height: clamp(12rem , 75vw, 15rem);\n}\n}\n{% endstyle %}"
              },
