{%- comment -%}
  Renders border override CSS
{%- endcomment -%}

{% capture border_radius %}{% render 'border-radius-style', settings: settings %}{% endcapture %}
{% assign border_radius = border_radius | strip %}
--border-width: {{ settings.border_width }}px; --border-style: {{ settings.border }}; --border-color:
{% if settings.border_color != blank -%}
  rgb({{ settings.border_color.rgba }})
{%- else -%}
  rgb(var(--color-border-rgb) / {{ settings.border_opacity | divided_by: 100.0 }})
{%- endif -%}
; --border-radius: {% if border_radius != blank %}{{ border_radius }}{% else %}0px{% endif %}; {% if border_radius != blank %} overflow: hidden; {% endif %}
