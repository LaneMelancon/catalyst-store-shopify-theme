

{% liquid
  assign block_settings = block.settings

  # The trigger is a `.button-unstyled`, whose own font/color/background/radius rules live in
  # base.css. Every custom style below is therefore applied through a modifier class so the
  # block stylesheet can reach the specificity needed to override them.
  capture trigger_classes
    if block_settings.type_preset == 'custom'
      echo ' custom-typography custom-font-size'
    endif
    if block_settings.text_color != blank
      echo ' popup-link__button--custom-color'
    endif
    if block_settings.background_color != blank
      echo ' popup-link__button--background'
    endif
    if block_settings.border_style == 'solid'
      echo ' popup-link__button--border'
    endif
    if block_settings.corner_radius > 0
      echo ' popup-link__button--radius'
    endif
  endcapture

  # The label is a bare text node, not a wrapped paragraph, so `--font-style` has to be set
  # explicitly — otherwise `.button-unstyled`'s `font-style: var(--font-subheading--style)`
  # keeps applying to whichever family was picked. The Size setting deliberately has no
  # "Default" option for the same reason: with a blank size, 'typography-style' emits the
  # per-element line-height variables instead of `--line-height`, and neither the line height
  # nor the letter spacing setting would resolve on an unwrapped label.
  if block_settings.type_preset == 'custom'
    assign trigger_font_style = block_settings.font | replace: 'family', 'style'
  endif

  # Falls back to the theme's border color when the merchant leaves the picker empty,
  # matching how 'border-override' resolves the same pair of settings.
  if block_settings.border_style == 'solid'
    assign border_alpha = block_settings.border_opacity | divided_by: 100.0
    if block_settings.border_color != blank
      assign trigger_border_color = block_settings.border_color.rgb | prepend: 'rgb(' | append: ' / '
    else
      assign trigger_border_color = 'rgb(var(--color-border-rgb) / '
    endif
    assign trigger_border_color = trigger_border_color | append: border_alpha | append: ')'
  endif
%}

<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
></script>

<dialog-component
  class="popup-link"
  {{ block.shopify_attributes }}
>
  <button
    on:click="/showDialog"
    class="button button-unstyled popup-link__button text-left spacing-style {{ block_settings.type_preset }}{{ trigger_classes }}"
    style="
      {% render 'spacing-style', settings: block_settings %}
      {% render 'typography-style', settings: block_settings %}
      {%- if trigger_font_style != blank -%}
        --font-style: {{ trigger_font_style }};
      {%- endif -%}
      {%- if block_settings.text_color != blank -%}
        --color: {{ block_settings.text_color }};
        --color-rgb: {{ block_settings.text_color.rgb }};
      {%- endif -%}
      {%- if block_settings.background_color != blank -%}
        --popup-link-background-color: {{ block_settings.background_color }};
      {%- endif -%}
      {%- if block_settings.border_style == 'solid' -%}
        --popup-link-border-width: {{ block_settings.border_width }}px;
        --popup-link-border-color: {{ trigger_border_color }};
      {%- endif -%}
      {%- if block_settings.corner_radius > 0 -%}
        --popup-link-corner-radius: {{ block_settings.corner_radius }}px;
      {%- endif -%}
    "
  >
    {{- block_settings.heading }}
    {{- 'icon-plus.svg' | inline_asset_content -}}
  </button>

  <dialog
    ref="dialog"
    class="popup-link__content dialog-modal color-custom-popover{% if block_settings.behavior == 'drawer' %} popup-link__content--drawer dialog-drawer{% endif %}"
    scroll-lock
    aria-labelledby="popup-dialog-heading"
  >
    <h2
      id="popup-dialog-heading"
      class="visually-hidden"
    >
      {{ block_settings.heading }}
    </h2>
    <div class="popup-link__inner">
      {% content_for 'blocks' %}
    </div>
    <button
      ref="closeButton"
      on:click="/closeDialog"
      class="button button-unstyled close-button popup-link__close"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>
  </dialog>
</dialog-component>

{% stylesheet %}
  .popup-link__button svg {
    display: inline-block;
    position: relative;
    top: var(--margin-2xs);
  }

  /* Each class is repeated to reach specificity 0,2,0 — enough to beat the
     `.button-unstyled` defaults in base.css that these settings replace. */
  .popup-link__button.custom-typography {
    font-style: var(--font-style);
  }

  .popup-link__button.popup-link__button--custom-color {
    color: var(--color);
  }

  .popup-link__button.popup-link__button--custom-color:hover {
    color: rgb(var(--color-rgb) / var(--opacity-70));
  }

  .popup-link__button.popup-link__button--background {
    background-color: var(--popup-link-background-color);
  }

  .popup-link__button.popup-link__button--border {
    box-shadow: inset 0 0 0 var(--popup-link-border-width) var(--popup-link-border-color);
  }

  .popup-link__button.popup-link__button--radius {
    border-radius: var(--popup-link-corner-radius);
  }

  .popup-link__content {
    box-shadow: var(--shadow-popover);
    border: var(--style-border-popover);
    border-radius: var(--style-border-radius-popover);
    background-color: var(--color-background);
    padding: var(--padding-4xl) var(--padding-xl) var(--padding-xl);
    max-width: var(--normal-content-width);
    max-height: var(--modal-max-height);

    @media screen and (min-width: 750px) {
      padding: var(--padding-5xl);
    }
  }

  .popup-link__content[open] {
    animation: modalSlideInTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .popup-link__content.dialog-closing {
    animation: modalSlideOutTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .popup-link__content--drawer {
    position: fixed;
    border-radius: 0;
    width: var(--sidebar-width);
    max-width: 95vw;
    height: 100%;
    margin: 0 0 0 auto;
  }

  /* Needed to ensure the drawer is full height */
  .popup-link__content--drawer:modal {
    max-height: 100dvh;
  }

  .popup-link__close {
    top: var(--margin-2xs);
    right: var(--margin-2xs);
    opacity: 0.8;
    animation: none;
  }
{% endstylesheet %}

